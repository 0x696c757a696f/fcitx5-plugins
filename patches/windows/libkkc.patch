diff --git a/meson.build b/meson.build
new file mode 100644
index 0000000..647bc66
--- /dev/null
+++ b/meson.build
@@ -0,0 +1,117 @@
+project('libkkc', ['vala', 'c', 'cpp'],
+  version: '0.3.5',
+  license: 'GPL3-or-later',
+  meson_version: '>= 0.57',
+)
+
+pkgconfig = import('pkgconfig')
+
+kkc_api_version = '1.0'
+
+prefix = get_option('prefix')
+libdir = prefix / get_option('libdir')
+datadir = prefix / get_option('datadir')
+pkgdatadir = datadir / 'libkkc'
+
+glib_dep = dependency('glib-2.0')
+gobject_dep = dependency('gobject-2.0')
+gio_dep = dependency('gio-2.0')
+gee_dep = dependency('gee-0.8')
+json_glib_dep = dependency('json-glib-1.0')
+marisa_dep = dependency('marisa')
+
+conf = configuration_data()
+conf.set_quoted('PACKAGE_DATADIR', pkgdatadir)
+conf.set_quoted('PACKAGE_NAME', meson.project_name())
+conf.set_quoted('PACKAGE_VERSION', meson.project_version())
+conf.set_quoted('DATADIR', datadir)
+conf.set_quoted('LIBDIR', libdir)
+conf.set_quoted('PKGDATADIR', pkgdatadir)
+conf.set_quoted('LOCALEDIR', datadir / 'locale')
+conf.set_quoted('GETTEXT_PACKAGE', meson.project_name())
+configure_file(output: 'config.h', configuration: conf)
+
+marisa_glib_lib = static_library('marisa-glib',
+  'marisa-glib/marisa-agent.cc',
+  'marisa-glib/marisa-key.cc',
+  'marisa-glib/marisa-keyset.cc',
+  'marisa-glib/marisa-trie.cc',
+  dependencies: [gio_dep, marisa_dep],
+)
+
+valac = meson.get_compiler('vala')
+
+libkkc_sources = files(
+  'libkkc/metadata-file.vala',
+  'libkkc/trellis-node.vala',
+  'libkkc/language-model.vala',
+  'libkkc/text-bigram-language-model.vala',
+  'libkkc/text-trigram-language-model.vala',
+  'libkkc/sorted-bigram-language-model.vala',
+  'libkkc/sorted-trigram-language-model.vala',
+  'libkkc/language-model-utils.vala',
+  'libkkc/decoder.vala',
+  'libkkc/bigram-decoder.vala',
+  'libkkc/trigram-decoder.vala',
+  'libkkc/segment-list.vala',
+  'libkkc/segment.vala',
+  'libkkc/bloom-filter.vala',
+  'libkkc/candidate-list.vala',
+  'libkkc/candidate.vala',
+  'libkkc/key-event-filter.vala',
+  'libkkc/key-event.vala',
+  'libkkc/keymap.vala',
+  'libkkc/keysyms.vala',
+  'libkkc/map-file.vala',
+  'libkkc/nicola.vala',
+  'libkkc/rom-kana-utils.vala',
+  'libkkc/rom-kana.vala',
+  'libkkc/rule.vala',
+  'libkkc/user-rule.vala',
+  'libkkc/context.vala',
+  'libkkc/state.vala',
+  'libkkc/initial-state-handler.vala',
+  'libkkc/convert-sentence-state-handler.vala',
+  'libkkc/convert-segment-state-handler.vala',
+  'libkkc/dictionary.vala',
+  'libkkc/segment-dictionary.vala',
+  'libkkc/system-segment-dictionary.vala',
+  'libkkc/user-segment-dictionary.vala',
+  'libkkc/sentence-dictionary.vala',
+  'libkkc/user-sentence-dictionary.vala',
+  'libkkc/user-dictionary.vala',
+  'libkkc/dictionary-list.vala',
+  'libkkc/encoding.vala',
+  'libkkc/template.vala',
+  'libkkc/numeric-template.vala',
+  'libkkc/expression.vala',
+  'libkkc/server.vala',
+  'libkkc/utils.vala',
+  'libkkc/kkc.vala',
+)
+
+vapi_dirs = [meson.current_source_dir() / 'libkkc', meson.current_source_dir() / 'marisa-glib']
+
+libkkc_lib = static_library('kkc',
+  libkkc_sources,
+  dependencies: [
+    glib_dep, gobject_dep, gio_dep, gee_dep, json_glib_dep,
+    valac.find_library('config', dirs: vapi_dirs),
+    valac.find_library('keysyms', dirs: vapi_dirs),
+    valac.find_library('marisa-glib', dirs: vapi_dirs),
+  ],
+  link_whole: marisa_glib_lib,
+  include_directories: include_directories('.', 'libkkc'),
+  vala_header: 'libkkc.h',
+  vala_vapi: 'kkc-@0@.vapi'.format(kkc_api_version),
+  c_args: ['-include', 'config.h', '-DG_LOG_DOMAIN="kkc"'],
+  install: true,
+  install_dir: [true, get_option('includedir') / 'libkkc', true],
+)
+
+pkgconfig.generate(libkkc_lib,
+  name: 'kkc-1.0',
+  filebase: 'kkc-1.0',
+  description: 'Japanese Kana Kanji conversion library',
+  requires: [gobject_dep, gio_dep, json_glib_dep, gee_dep, marisa_dep],
+)
