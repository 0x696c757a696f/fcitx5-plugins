diff --git a/cmake/mozc-static.cmake b/cmake/mozc-static.cmake
index ed79ece..1e60ba2 100644
--- a/cmake/mozc-static.cmake
+++ b/cmake/mozc-static.cmake
@@ -25,6 +25,20 @@ target_include_directories(mozc-static PRIVATE
 # Mozc requires char to be unsigned, as it's used as array index.
 target_compile_options(mozc-static PRIVATE -funsigned-char)
 
+if (WIN32)
+    # The definitions Mozc's own Windows build uses.
+    target_compile_definitions(mozc-static PRIVATE
+        -DWINVER=0x0A00
+        -D_WIN32_WINNT=0x0A00
+        -DNO_SHLWAPI_STRFCNS
+        -DPSAPI_VERSION=2
+        -DSTRSAFE_NO_DEPRECATE
+        -DUNICODE
+        -D_UNICODE
+    )
+    target_include_directories(mozc-static PRIVATE "${WIL_INCLUDE_DIR}")
+endif()
+
 target_compile_definitions(mozc-static PRIVATE
     -DMOZC_DATASET_MAGIC_NUMBER_LENGTH=7
 )
diff --git a/src/win32_util.cc b/src/win32_util.cc
new file mode 100644
index 0000000..49bba8b
--- /dev/null
+++ b/src/win32_util.cc
@@ -0,0 +1,66 @@
+// The parts of base/win32/win_util.cc and win_sandbox.cc that libmozc uses,
+// without ATL, which MinGW doesn't provide.
+#include <windows.h>
+
+#include <sddl.h>
+#include <shlobj.h>
+
+#include "base/win32/wide_char.h"
+#include "base/win32/win_sandbox.h"
+#include "base/win32/win_util.h"
+
+namespace mozc {
+namespace {
+
+std::optional<std::string> GetKnownFolderPath(REFKNOWNFOLDERID id) {
+    wil::unique_cotaskmem_string path;
+    if (FAILED(::SHGetKnownFolderPath(id, KF_FLAG_DEFAULT, nullptr, &path))) {
+        return std::nullopt;
+    }
+    return win32::WideToUtf8(path.get());
+}
+
+} // namespace
+
+const std::optional<std::wstring> &WinUtil::GetSystem32Path() {
+    static const std::optional<std::wstring> path =
+        []() -> std::optional<std::wstring> {
+        wchar_t buffer[MAX_PATH];
+        const UINT size = ::GetSystemDirectoryW(buffer, MAX_PATH);
+        if (size == 0 || size >= MAX_PATH) {
+            return std::nullopt;
+        }
+        return std::wstring(buffer, size);
+    }();
+    return path;
+}
+
+const std::optional<std::string> &WinUtil::GetProgramFilesX86Path() {
+    static const std::optional<std::string> path =
+        GetKnownFolderPath(FOLDERID_ProgramFilesX86);
+    return path;
+}
+
+const std::optional<std::string> &WinUtil::GetLocalAppDataPath() {
+    static const std::optional<std::string> path =
+        GetKnownFolderPath(FOLDERID_LocalAppData);
+    return path;
+}
+
+wil::unique_hlocal_security_descriptor
+WinSandbox::MakeSecurityDescriptor(ObjectSecurityType) {
+    // Full access for the owner, read access for everyone else.
+    wil::unique_hlocal_security_descriptor descriptor;
+    ::ConvertStringSecurityDescriptorToSecurityDescriptorW(
+        L"D:(A;;GA;;;OW)(A;;GA;;;SY)(A;;GR;;;WD)", SDDL_REVISION_1,
+        wil::out_param_ptr<PSECURITY_DESCRIPTOR *>(descriptor), nullptr);
+    return descriptor;
+}
+
+// Fcitx doesn't run Mozc inside app containers.
+bool WinSandbox::EnsureAllApplicationPackagesPermisssion(
+    std::wstring_view, AppContainerVisibilityType) {
+    return true;
+}
+
+} // namespace mozc
