diff --git a/src/cskk.cpp b/src/cskk.cpp
index 4a426a1..0b7b958 100644
--- a/src/cskk.cpp
+++ b/src/cskk.cpp
@@ -49,6 +49,7 @@
 #include <fcitx/inputpanel.h>
 #include <fcitx/text.h>
 #include <fcitx/userinterface.h>
+#include <cstdlib>
 #include <istream>
 #include <memory>
 #include <string>
@@ -76,6 +77,18 @@ FcitxCskkEngine::FcitxCskkEngine(Instance *instance)
         newCskkContext->applyConfig();
         return newCskkContext;
       }) {
+#ifdef _WIN32
+  // libcskk looks for its rules under XDG_DATA_DIRS, which Windows doesn't set.
+  auto ruleDir = StandardPaths::global().locate(StandardPathsType::Data,
+                                                "libcskk/rules");
+  if (!ruleDir.empty()) {
+    std::string dataDirs = ruleDir.parent_path().parent_path().generic_string();
+    if (const char *old = std::getenv("XDG_DATA_DIRS")) {
+      dataDirs = dataDirs + ";" + old;
+    }
+    _putenv_s("XDG_DATA_DIRS", dataDirs.c_str());
+  }
+#endif
   reloadConfig();
   instance_->inputContextManager().registerProperty("cskkcontext", &factory_);
 }
